{
  "name": "palco-mambembe",
  "version": "1.0.0",
  "description": "Cia de Teatro Palco Mambembe - 10 Anos",
  "main": "sw.js",
  "type": "commonjs",
  "scripts": {
    "build:css": "node -e \"require('minify')('assets/css/style.css').then(console.log)\" > assets/css/style.min.css",
    "build:js": "node -e \"require('minify')('assets/js/script.js').then(console.log)\" > assets/js/script.min.js",
    "build:html": "node -e \"require('minify')('index.html').then(console.log)\" > index.min.html",
    "build": "npm run build:css && npm run build:js && npm run build:html"
  },
    "allowScripts": {
    "@swc/core": true,
    "esbuild": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vickvick0710-projetos/projeto-palco-mambembe.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vickvick0710-projetos/projeto-palco-mambembe/issues"
  },
  "homepage": "https://github.com/vickvick0710-projetos/projeto-palco-mambembe#readme",
  "devDependencies": {
    "minify": "^15.3.1"
  }
}